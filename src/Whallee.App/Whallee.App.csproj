<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWPF>true</UseWPF>
    <AssemblyName>Whallee</AssemblyName>
    <RootNamespace>Whallee.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Embedded in the exe, which is what makes the Startup-folder shortcut and the taskbar show it
      without either of them naming an icon file. Whallee.ico carries 9 sizes (16-256); Windows
      picks per context, and the tray takes the 16/20/24 entries.

      Whallee-icon-source.png beside it is the exact square crop the .ico was generated from - kept
      so the icon can be rebuilt or retuned without re-deriving the crop by eye. The crop is tight
      on the head deliberately: the full scene it came from is unreadable below about 48px, because
      subject and background share one sepia palette. The eyes survive the downscale; the city does
      not.
    -->
    <ApplicationIcon>Whallee.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The SAME .ico, additionally embedded as a WPF resource so the nav rail can show it via
      pack://application:,,,/Whallee.ico. ApplicationIcon alone only stamps the exe's shell icon -
      it puts nothing in the assembly that XAML can address.
    -->
    <Resource Include="Whallee.ico" />

    <!--
      The 430px PNG the .ico was generated from, embedded so the nav rail can show a crisp icon.
      The .ico was tried first and does not work for this: it carries nine frames with the SMALLEST
      first, WPF hands out frame 0 (16x16), and DecodePixelWidth did not persuade the icon decoder
      to pick a different one - it still scaled 16px UP to 26 and looked like mud. A PNG has one
      frame and no ambiguity.
    -->
    <Resource Include="Whallee-icon-source.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- PINNED. The 2.4.x line requires net10.0-windows and fails NU1202 here; measured. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whallee.Core\Whallee.Core.csproj" />
  </ItemGroup>
</Project>
