<Application x:Class="Whallee.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                ORDER IS LOAD-BEARING. Controls.xaml resolves token keys out of Tokens.xaml, and
                Components.xaml resolves both. WPF merges in sequence, so a dictionary listed ahead
                of what it depends on fails at load with a XamlParseException - at run time, not at
                build time, which is the worst place to learn about it.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
