<Window x:Class="Whallee.App.Dialogs.UrlImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add from YouTube URL" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}">
    <StackPanel Margin="20">
        <TextBlock Text="YouTube link" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DockPanel>
            <Button x:Name="ProbeButton" Content="Look up" DockPanel.Dock="Right"
                    Margin="8,0,0,0" Click="Probe_Click" />
            <TextBox x:Name="UrlBox" />
        </DockPanel>

        <!-- ACCENT, NOT DANGER. Red overstates a tool that still works most of the time, and this
             line is advice, not an error. -->
        <!-- The button's Click is subscribed in the code-behind constructor, not here. -->
        <DockPanel x:Name="StaleToolPanel" Margin="0,10,0,0" Visibility="Collapsed">
            <Button x:Name="UpdateToolButton" DockPanel.Dock="Right" Content="Update yt-dlp"
                    Margin="8,0,0,0" VerticalAlignment="Top" />
            <TextBlock x:Name="StaleToolText" Foreground="{StaticResource AccentBrush}"
                       TextWrapping="Wrap" />
        </DockPanel>

        <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DurationText" Margin="0,2,0,0" />
            <TextBlock x:Name="LicenceText" Margin="0,2,0,0" TextWrapping="Wrap" />

            <TextBlock x:Name="SectionHeader" Text="Section to import"
                       FontWeight="SemiBold" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="StartBox" Width="80" Text="0:00" />
                <TextBlock Text="Length" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox x:Name="LengthBox" Width="80" Text="5:00" />
            </StackPanel>

            <!-- OPTIONAL, both of them. Blank name keeps the importer's own file name; blank genre
                 leaves the clip Ungrouped. Typing a genre that does not exist yet creates it. -->
            <TextBlock Text="Name (optional)" FontWeight="SemiBold" Margin="0,12,0,4" />
            <TextBox x:Name="NameBox" />

            <TextBlock Text="Genre (optional)" FontWeight="SemiBold" Margin="0,12,0,4" />
            <ComboBox x:Name="GenreBox" IsEditable="True" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ImportButton" Content="Import" IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Import_Click" />
            <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
