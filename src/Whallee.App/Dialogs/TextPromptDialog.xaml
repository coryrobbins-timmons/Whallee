<Window x:Class="Whallee.App.Dialogs.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whallee" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}">
    <StackPanel Margin="20">
        <TextBlock x:Name="LabelText" FontWeight="SemiBold" Margin="0,0,0,4" />

        <TextBox x:Name="ValueBox" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="OK" IsEnabled="False" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
