<Window x:Class="Whallee.App.Dialogs.RenameClipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename clip" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}">
    <StackPanel Margin="20">
        <TextBlock Text="New name" FontWeight="SemiBold" Margin="0,0,0,4" />

        <DockPanel>
            <!-- The extension is shown, never edited. See the code-behind remarks. -->
            <TextBlock x:Name="ExtensionText" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="NameBox" />
        </DockPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="Rename" IsEnabled="False" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
