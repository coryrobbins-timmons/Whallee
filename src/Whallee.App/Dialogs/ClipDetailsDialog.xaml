<Window x:Class="Whallee.App.Dialogs.ClipDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip details" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="NameText" FontWeight="SemiBold" TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Location" Margin="0,0,12,6" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PathText" Margin="0,0,0,6"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Margin="0,0,12,6" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SizeText" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Duration" Margin="0,0,12,6" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DurationText" Text="…"
                       Margin="0,0,0,6" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Resolution" Margin="0,0,12,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ResolutionText" Text="…" />
        </Grid>

        <Button Content="Close" HorizontalAlignment="Right" Margin="0,18,0,0"
                Padding="14,4" IsCancel="True" IsDefault="True" />
    </StackPanel>
</Window>
