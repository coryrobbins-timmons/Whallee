<UserControl x:Class="Whallee.App.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Whallee.App.Converters">
    <UserControl.Resources>
        <conv:PathToImageConverter x:Key="PathToImage" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Apply to:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="TargetSelector" Width="220" SelectedIndex="0" />
            <Button x:Name="AddFromFile" Content="Add from file…" Margin="16,0,0,0" Padding="8,2"
                    Click="AddFromFile_Click" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TileHost">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="6" Padding="0" BorderThickness="1" Tag="{Binding Path}"
                                Click="Tile_Click">
                            <StackPanel Width="240">
                                <Image Height="135" Stretch="UniformToFill"
                                       Source="{Binding ThumbnailPath,
                                                        Converter={StaticResource PathToImage}}" />
                                <TextBlock Text="{Binding FileName}" Margin="4"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
