<UserControl x:Class="Whallee.App.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Whallee.App.Converters"
             Style="{StaticResource AppPageStyle}">
    <UserControl.Resources>
        <conv:PathToImageConverter x:Key="PathToImage" />

        <!-- Tiles, when the library is one flat list. -->
        <ItemsPanelTemplate x:Key="FlatTilePanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- GROUPS stack vertically; the WrapPanel moves inside the group, below. Getting this
             backwards lays the genres out side by side and stacks the tiles. -->
        <ItemsPanelTemplate x:Key="GroupedTilePanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

        <GroupStyle x:Key="GenreGroupStyle">
            <GroupStyle.Panel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </GroupStyle.Panel>
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,12,0,8">
                        <!-- Name is the genre. An ungrouped group's Name is null, which would
                             otherwise render as a blank heading above real clips. -->
                        <TextBlock Text="{Binding Name, TargetNullValue=Ungrouped}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Height="1" Margin="0,6,0,0"
                                Background="{StaticResource StrokeBrush}" />
                    </StackPanel>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
    </UserControl.Resources>
    <Grid>
        <!-- ONE PER ROW USED BELOW, and count them when adding another. WPF does not complain about
             a Grid.Row past the last definition - it silently clamps the content into the last row,
             where it draws ON TOP of what is already there. That shipped twice on 2026-09-11. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- toolbar       -->
            <RowDefinition Height="Auto" />  <!-- import status -->
            <RowDefinition Height="Auto" />  <!-- genre bar     -->
            <RowDefinition Height="*" />     <!-- clips         -->
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Apply to" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox x:Name="TargetSelector" Width="240" SelectedIndex="0" />
            <Button x:Name="AddFromFile" Content="Add from file…" Margin="20,0,0,0"
                    Click="AddFromFile_Click" />
            <Button x:Name="AddFromUrl" Content="Add from YouTube URL…" Margin="8,0,0,0"
                    Click="AddFromUrl_Click" />
            <!-- Clicks subscribed in the constructor. Daily Shuffle is a toggle: amber
                 (PrimaryButtonStyle) while on, like the selected genre tab. -->
            <Button x:Name="ShuffleButton" Content="Shuffle" Margin="20,0,0,0" />
            <Button x:Name="DailyShuffleButton" Content="Daily Shuffle" Margin="8,0,0,0" />
        </StackPanel>

        <!--
            IMPORT PROGRESS. Collapsed unless an import is running.

            A YouTube import launches yt-dlp, downloads, then trims - several seconds during which
            the only feedback used to be the Add-from-URL button going grey. The importer already
            reported "96 MiB fetched…" through IProgress; that just had nowhere to appear once the
            log pane was removed, so this is where it appears now.

            The bar is indeterminate because the importer reports MiB fetched with no total to
            divide by - the real progress signal is the text, and the bar is there to say "still
            working" while the number is between updates.
        -->
        <Border x:Name="ImportStatus" Grid.Row="1" Visibility="Collapsed"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}"
                Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ImportStatusText" Text="Working…"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Only ever shown when reality differed from what was asked for. -->
                    <TextBlock x:Name="ImportStatusDetail" Visibility="Collapsed"
                               Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" />

                    <ProgressBar x:Name="ImportProgress" IsIndeterminate="True"
                                 Margin="0,10,0,0" />
                </StackPanel>

                <Button x:Name="ImportStatusDismiss" Grid.Column="1" Content="Dismiss"
                        Visibility="Collapsed" Margin="16,0,0,0" VerticalAlignment="Center"
                        Click="ImportStatusDismiss_Click" />
            </Grid>
        </Border>

        <!-- Collapsed until a genre exists, so it costs nothing before the owner tags anything.
             Populated in code: its buttons come from live state, exactly as ClipContextMenu does. -->
        <!-- Bottom margin 4, not 12: every tab now carries 8 below it (GenreBar.RowGap) so wrapped
             rows do not touch, and the two add back up to the original 12 above the clips. -->
        <WrapPanel x:Name="GenreBarHost" Grid.Row="2" Margin="0,0,0,4" Visibility="Collapsed" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0">
            <ItemsControl x:Name="TileHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                            STILL A BUTTON, AND Tag STILL BINDS Path. Tile_Click pattern-matches
                            `sender is not Button { Tag: string clipPath }`; changing either would
                            break clip application silently rather than loudly.
                        -->
                        <Button Margin="0,0,14,14" Tag="{Binding Path}"
                                Style="{StaticResource ClipCardStyle}"
                                Click="Tile_Click">
                            <!-- Deliberately EMPTY. Populated in code on ContextMenuOpening,
                                 because the "Apply to" submenu lists the displays attached at that
                                 moment. See ClipContextMenu. -->
                            <Button.ContextMenu>
                                <ContextMenu />
                            </Button.ContextMenu>
                            <StackPanel Width="240">
                                <!--
                                    An ImageBrush on a Border, not an Image element. That is what
                                    lets the thumbnail have rounded top corners at all - an Image
                                    cannot be corner-clipped without an OpacityMask. The brush
                                    takes the same UniformToFill the Image used.

                                    The Border underneath shows through while ThumbnailPath is
                                    still null, which it is for every tile until its frame has been
                                    generated - the grid appears at once and fills in.
                                -->
                                <Border Height="135" CornerRadius="7,7,0,0"
                                        Background="{StaticResource SurfaceOverlayBrush}">
                                    <Border CornerRadius="7,7,0,0">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill"
                                                        ImageSource="{Binding ThumbnailPath,
                                                                     Converter={StaticResource PathToImage}}" />
                                        </Border.Background>
                                    </Border>
                                </Border>

                                <!-- DisplayName, not FileName: the extension is noise repeated on
                                     every tile. The tooltip still carries the real file name,
                                     which matters because long names are ellipsised here. -->
                                <TextBlock Text="{Binding DisplayName}" Padding="10,8"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FileName}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
