<UserControl x:Class="Whallee.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource AppPageStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0">
            <!-- MaxWidth, not full bleed: settings rows are one label plus one control, and
                 stretching them across 900px puts the control a screen away from its label. -->
            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,16,0">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" />
                        <TextBlock x:Name="StartWithWindowsNote" Margin="26,6,0,0"
                                   Style="{StaticResource CaptionStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Displays" Style="{StaticResource SectionHeaderStyle}" />
                        <!-- Populated by BuildDisplayRows; empty in markup on purpose. -->
                        <StackPanel x:Name="DisplayHost" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Playback" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scaling" VerticalAlignment="Center" Width="170"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox x:Name="ScalingBox" Width="190" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Performance" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox x:Name="PauseFullscreenBox"
                                  Content="Pause when a fullscreen app is running" />
                        <TextBlock Text="Also pauses while the machine is locked."
                                   Margin="26,6,0,0" Style="{StaticResource CaptionStyle}" />
                        <CheckBox x:Name="PauseBatteryBox" Margin="0,14,0,0"
                                  Content="Pause while on battery" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
                        <!-- Populated by BuildAboutTable; empty in markup on purpose. -->
                        <Grid x:Name="AboutHost" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- The page's one committing action, and the only accent-filled button on it. -->
        <Button x:Name="ApplyButton" Grid.Row="1" Content="Apply (restarts playback)"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" Margin="0,14,16,0" IsEnabled="False" />
    </Grid>
</UserControl>
