<UserControl x:Class="Whallee.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,12,0">

                <TextBlock Text="General" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" />
                <TextBlock x:Name="StartWithWindowsNote" Margin="22,3,0,0" TextWrapping="Wrap"
                           Foreground="#808080" Visibility="Collapsed" />

                <TextBlock Text="Displays" FontWeight="Bold" FontSize="14" Margin="0,20,0,6" />
                <StackPanel x:Name="DisplayHost" />

                <TextBlock Text="Playback" FontWeight="Bold" FontSize="14" Margin="0,20,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Scaling" VerticalAlignment="Center" Width="170" />
                    <ComboBox x:Name="ScalingBox" Width="180" />
                </StackPanel>

                <TextBlock Text="Performance" FontWeight="Bold" FontSize="14" Margin="0,20,0,6" />
                <CheckBox x:Name="PauseFullscreenBox"
                          Content="Pause when a fullscreen app is running" />
                <TextBlock Text="Also pauses while the machine is locked."
                           Margin="22,2,0,0" Foreground="#808080" />
                <CheckBox x:Name="PauseBatteryBox" Margin="0,8,0,0"
                          Content="Pause while on battery" />

                <TextBlock Text="About" FontWeight="Bold" FontSize="14" Margin="0,20,0,6" />
                <Grid x:Name="AboutHost" />

            </StackPanel>
        </ScrollViewer>

        <Button x:Name="ApplyButton" Grid.Row="1" Content="Apply (restarts playback)"
                HorizontalAlignment="Right" Margin="0,12,12,0" Padding="14,4" IsEnabled="False" />
    </Grid>
</UserControl>
