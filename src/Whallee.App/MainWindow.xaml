<Window x:Class="Whallee.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whallee" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>
        <ListBox x:Name="PageSelector" Grid.Row="0" Margin="8" SelectedIndex="0"
                 SelectionChanged="PageSelector_SelectionChanged">
            <ListBoxItem Content="Library" />
            <ListBoxItem Content="Settings" />
        </ListBox>
        <ContentControl x:Name="PageHost" Grid.Row="0" Grid.Column="1" Margin="8" />
        <ListBox x:Name="LogView" Grid.Row="1" Grid.ColumnSpan="2" Margin="8"
                 FontFamily="Consolas" FontSize="11" />
    </Grid>
</Window>
