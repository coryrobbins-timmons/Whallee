<Window x:Class="Whallee.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whallee" Height="700" Width="1100" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- ========================= Nav rail ========================= -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <!-- The app's face. Without it the window opens cold, on a list. -->
                <StackPanel Orientation="Horizontal" Margin="16,18,12,18">
                    <!--
                        DecodePixelWidth IS WHAT MAKES THIS SHARP, and it is not optional.
                        Whallee.ico carries nine frames and the smallest is FIRST (16x16); a plain
                        Source= hands WPF frame 0, which then gets scaled UP to 26 and looks like
                        mud. Asking for 64 makes the icon decoder pick the 64x64 frame, which is
                        then scaled DOWN - and stays sharp at 150% DPI, where 26 DIP is 39 real
                        pixels.
                    -->
                    <Image Width="26" Height="26" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <BitmapImage UriSource="pack://application:,,,/Whallee.ico"
                                         DecodePixelWidth="64" />
                        </Image.Source>
                    </Image>
                    <TextBlock Text="Whallee" FontSize="16" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!--
                    RadioButtons, not a ListBox: mutual exclusion comes free and there is no
                    selected-index to keep in step with the page host. Both are wired in the
                    constructor rather than here, so nothing fires while InitializeComponent is
                    still walking the tree.
                -->
                <RadioButton x:Name="LibraryNav" GroupName="nav"
                             Style="{StaticResource NavItemStyle}">
                    <StackPanel Orientation="Horizontal">
                        <!-- A 2x2 grid of tiles: the library is a grid of clips. -->
                        <Path Style="{StaticResource NavIconStyle}"
                              Data="M 1,1 H 6 V 6 H 1 Z M 10,1 H 15 V 6 H 10 Z
                                    M 1,10 H 6 V 15 H 1 Z M 10,10 H 15 V 15 H 10 Z" />
                        <TextBlock Text="Library" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground,
                                                        RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SettingsNav" GroupName="nav"
                             Style="{StaticResource NavItemStyle}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Sliders. Reads as settings at 16px in a way a gear's teeth do not. -->
                        <Path Style="{StaticResource NavIconStyle}"
                              Data="M 1,4 H 14 M 1,12 H 14"
                              StrokeThickness="1.5" />
                        <Path Style="{StaticResource NavIconStyle}"
                              Data="M 5,1.5 V 6.5 M 11,9.5 V 14.5"
                              Margin="-16,0,0,0" />
                        <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground,
                                                        RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="20,18,20,18" />

    </Grid>
</Window>
