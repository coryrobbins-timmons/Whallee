<Window x:Class="Whallee.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whallee" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="PageSelector" Margin="8" SelectedIndex="0"
                 SelectionChanged="PageSelector_SelectionChanged">
            <ListBoxItem Content="Library" />
            <ListBoxItem Content="Settings" />
        </ListBox>
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="8" />
    </Grid>
</Window>
